  ItalicFont=*-Italic, BoldItalicFont=*-SemiBoldItalic]   % έντονα = SemiBold
\setmonofont{Consolas}
\RequirePackage{unicode-math}
\setmathfont{NewCMMath-Book.otf}   % κλασική Computer Modern, λίγο πιο έντονη (Book) για προβολέα
\setmathfont{NewCMMath-Bold.otf}[version=bold]   % \boldmath, έντονοι τίτλοι

% ---------- Στοίχιση ----------
% Πλήρης στοίχιση (αριστερά-δεξιά) με συλλαβισμό αντί για το \raggedright του beamer.
% Το beamer καλεί \raggedright σε κουκκίδες, στήλες κ.λπ., οπότε το αντικαθιστούμε παντού.
\RequirePackage{ragged2e}
\setlength{\JustifyingParindent}{0pt}
\newif\ifpdpjustify \pdpjustifytrue
\AtBeginDocument{\ifpdpjustify\let\raggedright\justifying\justifying\fi}

% ---------- Βήματα εμφάνισης ----------
\setbeamercovered{transparent}   % ό,τι δεν έχει εμφανιστεί ακόμα φαίνεται αχνό
\newcommand\pdptoctitle{Περιεχόμενα}
% Διαφάνεια περιεχομένων πριν από κάθε \section και κάθε \subsection.
%  - \section που ακολουθείται αμέσως από \subsection: δεν βγαίνει δική του
%    διαφάνεια (θα ήταν σχεδόν ίδια με αυτή της πρώτης υποενότητας).
%  - \subsection: λευκές μόνο η τρέχουσα ενότητα και η τρέχουσα υποενότητα.
%  - \pdpsubsectiontocfalse στο preamble: καμία διαφάνεια στις υποενότητες.
\newif\ifpdpsubsectiontoc \pdpsubsectiontoctrue
\newif\ifpdp@sectocpending
\AtBeginSection[]{\global\pdp@sectocpendingtrue}
\AtBeginSubsection[]{\ifpdpsubsectiontoc
  \pdptocframe[currentsection,currentsubsection]{\pdptoctitle}\fi}
\def\pdp@sectoc{\pdptocframe[currentsection]{\pdptoctitle}}
\def\pdp@aftersection{\ifpdp@sectocpending
  \global\pdp@sectocpendingfalse\expandafter\pdp@peek\fi}
\def\pdp@peek{\futurelet\pdp@next\pdp@peek@}
\def\pdp@peek@{%
  \ifx\pdp@next\@sptoken \let\pdp@do\pdp@eatsp
  \else\ifx\pdp@next\par \let\pdp@do\pdp@eatpar
  \else\ifx\pdp@next\subsection
    \ifpdpsubsectiontoc\let\pdp@do\relax\else\let\pdp@do\pdp@sectoc\fi
  \else \let\pdp@do\pdp@sectoc \fi\fi\fi
  \pdp@do}
\def\pdp@eatpar\par{\pdp@peek}
\@firstofone{\def\pdp@eatsp} {\pdp@peek}
\RequirePackage{etoolbox}
\apptocmd\beamer@section{\pdp@aftersection}{}%
  {\PackageWarning{beamerthemepdp}{could not patch \string\beamer@section}}

