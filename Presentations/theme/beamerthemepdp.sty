\newcommand\pdpcodesize{\fontsize{6.4}{9.6}\selectfont} % ύψος γραμμής 1.5 × μέγεθος, όπως στο VS Code

% Το listings τυπώνει * και - με μαθηματικά σύμβολα (χαμηλωμένο αστεράκι, μακρύ πλην) όταν η
% γραμματοσειρά δεν είναι η \ttfamily του εγγράφου. Του λέμε να κρατά τους χαρακτήρες της Cascadia.
\newcommand\pdp@codeinit{\let\lst@ttfamily\@firstoftwo}

% Αυτόματη αφαίρεση εσοχής: ο κώδικας ξεκινά από το αριστερό άκρο του πλαισίου, όση εσοχή
% κι αν έχει στο .tex ή στο .cpp. Βρίσκουμε την εσοχή της λιγότερο εσοχής γραμμής (αγνοώντας τις
% κενές) μέσα στο εύρος firstline–lastline, γράφουμε ένα αντίγραφο του κώδικα χωρίς αυτήν
% (\jobname.pdpcode) και το listings διαβάζει αυτό. Τα tab στην αρχή μετράνε 4 κενά.
% Με gobble=… αφαιρούνται ακριβώς τόσοι χαρακτήρες αντί για την αυτόματη εσοχή.
% (Το gobble του listings δεν δουλεύει για κώδικα από αρχείο, γι' αυτό το κάνουμε εδώ.)
\ExplSyntaxOn
\ior_new:N \g__pdp_code_ior
\iow_new:N \g__pdp_code_iow
\int_new:N \l__pdp_min_int
\int_new:N \l__pdp_line_int
\int_new:N \l__pdp_first_int
\int_new:N \l__pdp_last_int
\seq_new:N \l__pdp_lines_seq
\tl_new:N \l__pdp_line_tl
\cs_new:Npn \pdp@codefile {}
\cs_new_protected:Npn \__pdp_detab:
  {
    \regex_replace_once:nnNT { \A(\ *)\t } { \1\ \ \ \ } \l__pdp_line_tl
      { \__pdp_detab: }
  }
\cs_new_protected:Npn \pdp@dedent #1
  {
    \seq_clear:N \l__pdp_lines_seq
    \int_set:Nn \l__pdp_first_int { \lst@firstline }
    \int_set:Nn \l__pdp_last_int { \lst@lastline }
    \int_set:Nn \l__pdp_min_int { 100000 }
    \int_zero:N \l__pdp_line_int
    \ior_open:Nn \g__pdp_code_ior {#1}
    \ior_str_map_inline:Nn \g__pdp_code_ior
      {
        \int_incr:N \l__pdp_line_int
        \tl_set:Nn \l__pdp_line_tl {##1}
        \ifnum \l__pdp_line_int < \lst@firstline \else
        \ifnum \l__pdp_line_int > \lst@lastline \else
          \__pdp_detab:
          \regex_extract_once:nVNT { \A(\ *)\S } \l__pdp_line_tl \l_tmpa_seq
            {
              \int_set:Nn \l_tmpa_int
                { \exp_args:Ne \str_count:n { \seq_item:Nn \l_tmpa_seq { 2 } } }
              \int_compare:nNnT \l_tmpa_int < \l__pdp_min_int
                { \int_set_eq:NN \l__pdp_min_int \l_tmpa_int }
            }
        \fi \fi
        \seq_put_right:NV \l__pdp_lines_seq \l__pdp_line_tl
      }
    \ior_close:N \g__pdp_code_ior
    \int_compare:nNnT \l__pdp_min_int = { 100000 } { \int_zero:N \l__pdp_min_int }
    \ifnum \lst@gobble > \z@ \int_set:Nn \l__pdp_min_int { \lst@gobble } \fi
    \int_compare:nNnTF \l__pdp_min_int = { 0 }
      { \cs_set:Npn \pdp@codefile {#1} }
      {
        \cs_set:Npe \pdp@codefile { \c_sys_jobname_str .pdpcode }
        \iow_open:Nn \g__pdp_code_iow { \c_sys_jobname_str .pdpcode }
        \int_zero:N \l__pdp_line_int
        \seq_map_inline:Nn \l__pdp_lines_seq
          {
            \int_incr:N \l__pdp_line_int
            \bool_lazy_or:nnTF
              { \int_compare_p:nNn \l__pdp_line_int < \l__pdp_first_int }
              { \int_compare_p:nNn \l__pdp_line_int > \l__pdp_last_int }
              { \iow_now:Ne \g__pdp_code_iow { \tl_to_str:n {##1} } }
              {
                \iow_now:Ne \g__pdp_code_iow
                  { \str_range:nnn {##1} { \l__pdp_min_int + 1 } { -1 } }
              }
          }
        \iow_close:N \g__pdp_code_iow
      }
  }
\ExplSyntaxOff
\patchcmd\lst@InputListing{\let\lst@gobble\z@}{\pdp@dedent{#1}\let\lst@gobble\z@}{}%
  {\PackageWarning{beamerthemepdp}{could not patch listings for dedent}}
\patchcmd\lst@InputListing{\input{#1}}{\input{\pdp@codefile}}{}%
  {\PackageWarning{beamerthemepdp}{could not patch listings for dedent}}

