% ---------- Blocks: πλαϊνή γραμμή, ο τίτλος έντονος μέσα στην πρώτη γραμμή ----------
% Ίδια συμπεριφορά για block (μπλε), alertblock (κόκκινο), exampleblock (πράσινο).
%
% Σειρά εμφάνισης: το κουτί και ο τίτλος εμφανίζονται στο βήμα όπου ανοίγει το block.
% Το κείμενο μέσα ακολουθεί τα δικά σου \pause, π.χ.
%   \begin{block}{Απόδειξη.} Πρώτη πρόταση. \pause Δεύτερη. \end{block}
%      → κουτί + πρώτη πρόταση μαζί, η δεύτερη στο επόμενο βήμα
%   \begin{block}{Απόδειξη.} \pause Όλο το κείμενο. \end{block}
%      → πρώτα μόνο το κουτί με τον τίτλο, το κείμενο στο επόμενο βήμα
%
% Για να μένει το κουτί ορατό ενώ το κείμενο είναι ακόμα αχνό, κρατάμε την κατάσταση
% «αχνότητας» του beamer τη στιγμή που ανοίγει το block και τη χρησιμοποιούμε όταν
% σχεδιάζεται το κουτί (το tcolorbox σχεδιάζει το φόντο του στο τέλος).
% \pdp@blockbegin[φόντο]{χρώμα}: χωρίς [φόντο] → πολύ ανοιχτή απόχρωση του χρώματος
\newcommand\pdp@blockbegin[2][]{%
  \par\vskip0.6\medskipamount
  \global\let\pdp@hook@begin\beamer@colorhook
  \global\let\pdp@ext@begin\beamer@pgfextension
  \ifx\relax#1\relax\def\pdp@blockbg{#2!6}\else\def\pdp@blockbg{#1}\fi
  \pdp@blockbox{#2}}
\newcommand\pdp@blockbox[1]{%
  % στρογγυλές γωνίες όπως ο κώδικας· η πλαϊνή γραμμή κόβεται στο σχήμα του κουτιού
  \begin{tcolorbox}[enhanced, breakable=false, arc=3pt, boxrule=0pt,
      colback=\pdp@blockbg, colframe=\pdp@blockbg, frame hidden,
      overlay={\begin{tcbclipinterior}\fill[#1] (interior.south west)
        rectangle ([xshift=2pt]interior.north east-|interior.west);\end{tcbclipinterior}},
      left=6pt, right=6pt, top=4pt, bottom=4pt, before skip=0pt, after skip=0pt]
  \ifx\insertblocktitle\@empty\else{\color{#1}\bfseries\insertblocktitle}\ \fi
  \ignorespaces}
\newcommand\pdp@blockend{%
  % το κουτί σχεδιάζεται με την κατάσταση που είχε το block όταν άνοιξε
  \global\let\pdp@hook@end\beamer@colorhook
  \global\let\pdp@ext@end\beamer@pgfextension
  \global\let\beamer@colorhook\pdp@hook@begin
  \global\let\beamer@pgfextension\pdp@ext@begin
  \end{tcolorbox}%
  \global\let\beamer@colorhook\pdp@hook@end
  \global\let\beamer@pgfextension\pdp@ext@end
  \color{.}%
  \par\vskip0.6\medskipamount}

\setbeamertemplate{block begin}{\pdp@blockbegin{pdpblue}}
\setbeamertemplate{block end}{\pdp@blockend}
\setbeamertemplate{block example begin}{\pdp@blockbegin{green!45!black}}
\setbeamertemplate{block example end}{\pdp@blockend}
\setbeamertemplate{block alerted begin}{\pdp@blockbegin{red!65!black}}
\setbeamertemplate{block alerted end}{\pdp@blockend}

% Κίτρινο κουτί για σημειώσεις: \begin{noteblock}{Σημείωση.} ... \end{noteblock}
% (σκούρο κεχριμπαρένιο για γραμμή/τίτλο, γιατί το καθαρό κίτρινο δεν διαβάζεται σε λευκό)
