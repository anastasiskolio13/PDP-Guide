% =====================================================================
%  beamerthemepdp — θέμα beamer (16:9) στα χρώματα του ΠΔΠ / ΠΑΔΑ
%
%  Δομή φακέλου:
%    Presentations/
%      theme/            κοινό για όλες: αυτό το αρχείο, images/, fonts/
%      <Επίπεδο>/        Basic, Junior, Senior
%        <Όνομα>/        ένας φάκελος ανά παρουσίαση
%          Όνομα.tex
%          *.cpp         ό,τι χρειάζεται μόνο αυτή η παρουσίαση (για \cppfile)
%
%  Χρήση (XeLaTeX, compile μέσα στον φάκελο της παρουσίασης):
%    \documentclass[t,aspectratio=169,9pt]{beamer}
%    \makeatletter\def\input@path{{../../theme/}}\makeatother   % το θέμα είναι στο ../../theme/
%    \usetheme{pdp}
%    \title{...} \author{...} ...
%
%    \pdptitleframe                 % διαφάνεια τίτλου
%    \pdptocframe{Περιεχόμενα}      % μπλε διαφάνεια με όλες τις ενότητες
%
%  Το θέμα φορτώνει ήδη: γραμματοσειρές (Fira Sans, Consolas, New Computer Modern Math Book),
%  ελληνικά (babel), amsmath, tikz, hyperref (από το beamer), αχνό κείμενο πριν
%  εμφανιστεί, και μπλε διαφάνεια περιεχομένων στην αρχή κάθε \section/\subsection
%  (ο τίτλος της αλλάζει με \renewcommand\pdptoctitle{...}).
%
%  Blocks (block, exampleblock, alertblock): πλαϊνή γραμμή, χωρίς μπάρα τίτλου.
%  Κώδικας: \begin{frame}[fragile] ... \begin{cpp} ... \end{cpp}
%           ή \cppfile{αρχείο.cpp}
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemepdp}[2026/11/11 PDP beamer theme]

\RequirePackage{tikz}
\RequirePackage{amsmath}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}

