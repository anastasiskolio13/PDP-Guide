\lstdefinestyle{pdpcpp}{
  language=C++,
  % το βασικό χρώμα (vsfg) μπαίνει από το πλαίσιο (colupper)
  basicstyle=\pdp@codeinit\pdpcodefont\pdpcodesize,
  keywordstyle=\color{vskw},
  morekeywords={auto,nullptr,constexpr,noexcept,override,final,decltype},
  keywordstyle=[2]\color{vstype},
  morekeywords=[2]{vector,pair,set,map,unordered_map,unordered_set,priority_queue,queue,
    deque,stack,greater,less,tuple,array,string,bitset,size_t,ll,P},
  keywordstyle=[3]\color{vsmacro},
  morekeywords=[3]{INF,MOD,MAXN},
  commentstyle=\color{vscom},
  stringstyle=\color{vsstr},
  directivestyle=\color{vsdir},
  literate=*{0}{{\textcolor{vsnum}{0}}}1 {1}{{\textcolor{vsnum}{1}}}1
            {2}{{\textcolor{vsnum}{2}}}1 {3}{{\textcolor{vsnum}{3}}}1
            {4}{{\textcolor{vsnum}{4}}}1 {5}{{\textcolor{vsnum}{5}}}1
            {6}{{\textcolor{vsnum}{6}}}1 {7}{{\textcolor{vsnum}{7}}}1
            {8}{{\textcolor{vsnum}{8}}}1 {9}{{\textcolor{vsnum}{9}}}1,
  numbers=none, numberstyle=\pdpcodefont\pdpcodesize\color{vslineno}, numbersep=8pt,
  tabsize=4, showstringspaces=false, columns=fullflexible, keepspaces=true,
  extendedchars=true, upquote=true,
  breaklines=true, breakatwhitespace=false,
  aboveskip=0pt, belowskip=0pt,
}

% Απλό πλαίσιο: μόνο ο κώδικας, λίγο στρογγυλεμένο, χωρίς μπάρα και αριθμούς γραμμών
% (ίδιες διαστάσεις με το πλαίσιο του ψευδοκώδικα).
\tcbset{pdpcode/.style={enhanced, listing only, arc=3pt, boxrule=0.4pt,
    colback=vsbg, colframe=vsframe, colupper=vsfg, boxsep=0pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt, before skip=2pt, after skip=4pt}}

% Με αριθμούς γραμμών, όταν χρειάζεται: [style=numbered]
\lstdefinestyle{numbered}{numbers=left, xleftmargin=14pt}

% \begin{cpp} ... \end{cpp}          ή  \begin{cpp}[style=numbered]
% (οποιαδήποτε επιλογή του listings μπαίνει στις αγκύλες)
% (το "!O{}" κοιτάει για [...] μόνο στην ίδια γραμμή, ώστε μια πρώτη γραμμή κώδικα
%  που ξεκινά με # — π.χ. #include — να μη διαβάζεται κατά λάθος ως LaTeX)
\DeclareTCBListing{cpp}{ !O{} }{pdpcode, listing options={style=pdpcpp,#1}}
% \cppfile[επιλογές listings]{αρχείο.cpp} — το αρχείο διαβάζεται από τον φάκελο της παρουσίασης
\newtcbinputlisting{\cppfile}[2][]{pdpcode, listing file={\pdpcodedir #2},
  listing options={style=pdpcpp,#1}}

% ---------- Ψευδοκώδικας σε στυλ Cormen (CLRS, 4η έκδοση) ----------
% Το clrscode4e.sty (στον φάκελο theme/) είναι του ίδιου του Cormen, από το
% https://mitp-content-server.mit.edu/books/content/sectbyfn/books_pres_0/11599/clrscode4e.sty
% και βγάζει τη μορφή του βιβλίου: ονόματα διαδικασιών σε μικρά κεφαλαία, έντονες λέξεις-κλειδιά,
% αριθμημένες γραμμές, εσοχές χωρίς «end», ανάθεση με =, έλεγχος με ==, σχόλια // σε σκούρο κόκκινο.
%   \begin{pseudo}
%   \Procname{$\proc{Insertion-Sort}(A, n)$}
%   \li \For $i \gets 2$ \To $n$
%   \li   \Do $\id{key} \gets A[i]$
%   ...   \End
%   \end{pseudo}
% Το clrscode4e ζητά xcolor με [cmyk]· το beamer το έχει ήδη φορτώσει, οπότε δηλώνουμε ότι
% η επιλογή υπάρχει, για να μη βγει «option clash» (τα χρώματα μετατρέπονται κανονικά).
\@ifpackagewith{xcolor}{cmyk}{}{%
  \expandafter\edef\csname opt@xcolor.sty\endcsname{\csname opt@xcolor.sty\endcsname,cmyk}}
\RequirePackage{clrscode4e}
\selectcolormodel{natural}   % το clrscode4e γυρίζει τα χρώματα σε CMYK (για εκτύπωση)· τα θέλουμε όπως ορίστηκαν
\definecolor{pdptan}{cmyk}{0,0.05,0.17,0}   % το ανοιχτό μπεζ φόντο του βιβλίου: \begin{pseudo}[colback=pdptan]
\newfontfamily\pdppseudofont{Libertinus Serif}   % serif όπως στο βιβλίο, με ελληνικά και μικρά κεφαλαία
\newcommand\pdppseudosize{\small}
\newenvironment{pseudo}[1][]{%
  \par
  % όπως στα κουτάκια: το πλαίσιο σχεδιάζεται με την κατάσταση της αρχής του (όχι αχνό)
  \global\let\pdp@hook@begin\beamer@colorhook
  \global\let\pdp@ext@begin\beamer@pgfextension
  \begin{tcolorbox}[enhanced, arc=3pt, boxrule=0.4pt, colback=white, colframe=pdpblue!30,
      left=8pt, right=8pt, top=2pt, bottom=4pt, boxsep=0pt, before skip=2pt, after skip=4pt,
      width=\linewidth, #1]
  \pdppseudofont\pdppseudosize
  % κάθε γραμμή ξαναδιαβάζει το τρέχον χρώμα, ώστε να δουλεύει το \pause ανάμεσα σε γραμμές
  \let\pdp@li\li \renewcommand{\li}{\pdp@li\color{.}}%
  \let\pdp@zi\zi \renewcommand{\zi}{\pdp@zi\color{.}}%
  % το ίδιο μετά από κάθε αλλαγή στήλης (\Do, \Then, \Else, ...), αλλιώς το κείμενο μετά από αυτά
  % στην ίδια γραμμή δεν γίνεται αχνό
  \let\pdp@Do\Do \renewcommand{\Do}{\pdp@Do\color{.}}%
  \let\pdp@Then\Then \renewcommand{\Then}{\pdp@Then\color{.}}%
  \let\pdp@Else\Else \renewcommand{\Else}{\pdp@Else\color{.}}%
  \let\pdp@ElseNoIf\ElseNoIf \renewcommand{\ElseNoIf}{\pdp@ElseNoIf\color{.}}%
  \let\pdp@Repeat\Repeat \renewcommand{\Repeat}{\pdp@Repeat\color{.}}%
  % ονόματα διαδικασιών/σταθερών και πολυγράμματα αναγνωριστικά με τη serif του ψευδοκώδικα
  % (αλλιώς το \textnormal του clrscode3e θα έπαιρνε τη sans των διαφανειών)
  \renewcommand{\proc}[1]{\textnormal{\pdppseudofont\scshape ##1}}%
  \renewcommand{\const}[1]{\textnormal{\pdppseudofont\scshape ##1}}%
  \renewcommand{\id}[1]{\ensuremath{\textnormal{\pdppseudofont\itshape ##1}}}%
  \begin{codebox}}
  {\end{codebox}%
   \global\let\pdp@hook@end\beamer@colorhook
   \global\let\pdp@ext@end\beamer@pgfextension
   \global\let\beamer@colorhook\pdp@hook@begin
   \global\let\beamer@pgfextension\pdp@ext@begin
   \end{tcolorbox}%
   \global\let\beamer@colorhook\pdp@hook@end
   \global\let\beamer@pgfextension\pdp@ext@end
   \color{.}\par}

% ---------- Φόντο: λογότυπο, τίτλος, γραμμή, αρίθμηση ----------
\setbeamertemplate{background}{%
  \begin{tikzpicture}[x=1pt, y=1pt]
    \useasboundingbox (0,0) rectangle (\paperwidth, \paperheight);
    \ifpdptitle
      % διαγώνιο μπλε κομμάτι δεξιά
      \fill[pdpblue] (0.74\paperwidth, \paperheight) -- (\paperwidth, \paperheight)
                  -- (\paperwidth, 0) -- (0.56\paperwidth, 0) -- cycle;
      \ifpdptitlealllogos
        % ΠΔΠ στο κέντρο του μπλε κομματιού, από κάτω ΠΑΔΑ (αριστερά) και ΕΜΠ (δεξιά)
        \node[inner sep=0pt] (pdp@c) at (0.83\paperwidth, 48mm)
          {\includegraphics[width=46mm]{\pdpendcenter}};
        \node[inner sep=0pt, anchor=north east] at ([xshift=-4mm, yshift=-7mm]pdp@c.south)
          {\includegraphics[height=17mm]{\pdpendleft}};
        \node[inner sep=0pt, anchor=north west] at ([xshift=4mm, yshift=-7mm]pdp@c.south)
          {\includegraphics[height=17mm]{\pdpendright}};
      \else\ifx\pdpcover\@empty\else
        \node[anchor=south east, inner sep=0pt] at ([xshift=-6mm, yshift=8mm]\paperwidth, 0)
          {\includegraphics[width=0.3\paperwidth]{\pdpcover}};
      \fi\fi
    \else\ifpdpclosing
      % τελική διαφάνεια: μόνο μπλε φόντο, τα λογότυπα είναι στο περιεχόμενο
      \fill[pdpblue] (0,0) rectangle (\paperwidth, \paperheight);
    \else
      \ifpdpdark \fill[pdpblue] (0,0) rectangle (\paperwidth, \paperheight); \fi
      % λογότυπα πάνω δεξιά: ΠΑΔΑ – ΠΔΠ – ΕΜΠ
      \node[anchor=north east, inner sep=0pt] (pdp@r) at ([xshift=-\pdpmx, yshift=-3.6mm]\paperwidth, \paperheight)
        {\includegraphics[height=\pdplogoh]{\ifpdpdark\pdpsiderightdark\else\pdpsideright\fi}};
      \node[anchor=north east, inner sep=0pt] (pdp@m) at ([xshift=-2.5mm]pdp@r.north west)
        {\includegraphics[height=\pdplogoh]{\ifpdpdark\pdplogodark\else\pdplogo\fi}};
      \node[anchor=north east, inner sep=0pt] at ([xshift=-2.5mm]pdp@m.north west)
        {\includegraphics[height=\pdplogoh]{\ifpdpdark\pdpsideleftdark\else\pdpsideleft\fi}};
      % τίτλος αριστερά, κάτω από τη γραμμή στο ύψος των λογοτύπων
      \node[anchor=west, inner sep=0pt, text width=\paperwidth-2\pdpmx-\pdplogoh*5.5-9mm,
            font=\usebeamerfont{frametitle}, text=\ifpdpdark white\else pdpblue\fi]
        at (\pdpmx, \paperheight-3.6mm-0.5\pdplogoh)
        {\insertframetitle\ifx\beamer@framesubtitle\@empty\else\\[-1pt]{\usebeamerfont{framesubtitle}\insertframesubtitle}\fi};
      % λεπτή γραμμή κάτω από τον τίτλο
      \draw[line width=0.5pt, \ifpdpdark white!50!pdpblue\else pdpblue!35\fi]
        (\pdpmx, \paperheight-\pdpliney) -- (\paperwidth-\pdpmx, \paperheight-\pdpliney);
      % αρίθμηση (όχι στις σελίδες περιεχομένων, που δεν μετράνε)
      \ifpdpdark\else
      \node[anchor=south west, inner sep=0pt, font=\tiny, text=pdpmuted]
        at (\pdpmx, 3.8mm) {\insertframenumber\,/\,\inserttotalframenumber};
      \fi
    \fi\fi
  \end{tikzpicture}%
}

% Ο τίτλος σχεδιάζεται στο φόντο· εδώ μόνο κρατάμε χώρο από πάνω και κάτω.
\setbeamertemplate{frametitle}{}
\setbeamertemplate{headline}{\vskip 15.5mm}
\setbeamertemplate{footline}{\vskip 4.5mm}

% ---------- Πίνακας περιεχομένων (στις μπλε διαφάνειες) ----------
\setbeamertemplate{section in toc}{%
  \leavevmode{\scriptsize\raise0.15ex\hbox{$\blacktriangleright$}}\hspace{0.6em}\inserttocsection\par\vspace{0.6em}}
\setbeamertemplate{section in toc shaded}{%
  {\color{white!40!pdpblue}\leavevmode{\scriptsize\raise0.15ex\hbox{$\blacktriangleright$}}\hspace{0.6em}\inserttocsection\par}\vspace{0.6em}}
% Υποενότητες: κάτω από την ενότητά τους, με εσοχή, μικρότερα γράμματα και κενό τρίγωνο.
% Στις σελίδες ανά ενότητα φαίνονται μόνο οι υποενότητες της τρέχουσας ενότητας.
\newcommand\pdp@subtocitem{%
  \leavevmode\hspace*{1.7em}{\tiny\raise0.3ex\hbox{$\triangleright$}}\hspace{0.5em}%
  {\small\inserttocsubsection}\par\vspace{0.3em}}
\setbeamertemplate{subsection in toc}{\vspace{-0.3em}\pdp@subtocitem\vspace{0.1em}}
\setbeamertemplate{subsection in toc shaded}{%
  \vspace{-0.3em}{\color{white!40!pdpblue}\pdp@subtocitem}\vspace{0.1em}}

% ---------- Διαφάνεια τίτλου ----------
\setbeamertemplate{title page}{%
  \vfill
  \begin{minipage}{0.5\paperwidth}
    \rightskip 0pt plus 1fil\relax \spaceskip\fontdimen2\font\relax \hyphenpenalty 10000\relax
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
    \ifx\beamer@subtitle\@empty\else
      \vspace{0.3em}{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
    \fi
    \vspace{0.6em}{\usebeamerfont{author}\insertauthor\par}
    {\usebeamerfont{institute}\insertinstitute\par}
    {\usebeamerfont{date}\insertdate\par}
  \end{minipage}
  \vfill
}

\newcommand\pdptitleframe{%
  \begingroup\pdptitletrue
  \begin{frame}[plain,c,noframenumbering]\titlepage\end{frame}%
  \endgroup}

% \pdptocframe{Τίτλος}                  όλες οι ενότητες
% \pdptocframe[currentsection]{Τίτλος}  η τρέχουσα λευκή, οι άλλες αχνές
\newcommand\pdptocframe[2][]{%
  \begingroup\pdpdarktrue
  \setbeamercolor{normal text}{fg=white}%
  \setbeamercolor{structure}{fg=white}%
  \begin{frame}[noframenumbering]\frametitle{#2}\vspace{2mm}\tableofcontents[#1]\end{frame}%
  \endgroup}

% Τελική διαφάνεια: μπλε φόντο με τα λογότυπα ΠΑΔΑ – ΠΔΠ – ΕΜΠ σε λευκό
\newcommand\pdpclosingframe{%
  \begingroup\pdpclosingtrue
  \begin{frame}[plain,c,noframenumbering]
    \centering
    \begin{tikzpicture}
      \node[inner sep=0pt] (c) at (0,0) {\includegraphics[width=56mm]{\pdpendcenter}};
      \node[inner sep=0pt] at ([xshift=-12mm]c.west) [anchor=east]
        {\includegraphics[height=30mm]{\pdpendleft}};
      \node[inner sep=0pt] at ([xshift=12mm]c.east) [anchor=west]
        {\includegraphics[height=30mm]{\pdpendright}};
    \end{tikzpicture}
  \end{frame}%
  \endgroup}

% Υπογραμμισμένη ετικέτα: \field{Είσοδος:}
\newcommand\field[1]{\par\smallskip{\usebeamercolor[fg]{structure}\underline{#1}}\par\smallskip}

% Σύνδεσμος-κουμπί: \pdpcodelink{url}{Ενδεικτική κωδικοποίηση}
\newcommand\pdpcodelink[2]{%
  \href{#1}{\setlength\fboxrule{0.6pt}\setlength\fboxsep{4pt}%
    \fcolorbox{pdpblue}{white}{\textcolor{pdpblue}{\textbf{#2}~$\nearrow$}}}}

\mode<all>
